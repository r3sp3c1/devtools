{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "devtools",
  "title": "DevTools",
  "description": "A clone of DevUtils. Because having two identical tools is better than one.",
  "icon": "command-icon.png",
  "author": "Antigravity",
  "license": "MIT",
  "commands": [
    {
      "name": "dashboard",
      "title": "DevTools",
      "description": "Launch the ultimate DevTools dashboard",
      "mode": "view",
      "preferences": [
        {
          "name": "defaultTailMode",
          "title": "Default Tail/Head Mode",
          "description": "Default mode for the File Tail tool",
          "type": "dropdown",
          "required": false,
          "default": "tail",
          "data": [
            {
              "title": "Tail",
              "value": "tail"
            },
            {
              "title": "Head",
              "value": "head"
            }
          ]
        },
        {
          "name": "defaultTailLines",
          "title": "Default Tail/Head Lines",
          "description": "Default number of lines to show",
          "type": "textfield",
          "required": false,
          "default": "50"
        },
        {
          "name": "pcapInterface",
          "title": "Default PCAP Interface",
          "description": "Network interface to sniff (e.g. en0)",
          "type": "textfield",
          "required": false,
          "default": "en0"
        },
        {
          "name": "pcapFolder",
          "title": "Default PCAP Output Folder",
          "description": "Path to save .pcap files",
          "type": "textfield",
          "required": false,
          "default": "~/Downloads"
        },
        {
          "name": "pcapTimeLimit",
          "title": "PCAP Time Limit (Seconds)",
          "description": "Stop capture after X seconds",
          "type": "textfield",
          "required": false,
          "default": "60"
        },
        {
          "name": "pcapSizeLimit",
          "title": "PCAP Size Limit (MB)",
          "description": "Stop capture after X MBs",
          "type": "textfield",
          "required": false,
          "default": "100"
        },
        {
          "name": "sshTerminal",
          "title": "SSH Terminal App",
          "description": "Terminal for SSH connections",
          "type": "dropdown",
          "required": false,
          "default": "iTerm",
          "data": [
            {
              "title": "Apple Terminal",
              "value": "Terminal"
            },
            {
              "title": "iTerm2",
              "value": "iTerm"
            }
          ]
        },
        {
          "name": "defaultArchiveFormat",
          "title": "Default Archive Format",
          "description": "Default format for the Archive Manager",
          "type": "dropdown",
          "required": false,
          "default": "zip",
          "data": [
            {
              "title": "ZIP",
              "value": "zip"
            },
            {
              "title": "TAR.GZ",
              "value": "tar.gz"
            },
            {
              "title": "TAR",
              "value": "tar"
            }
          ]
        },
        {
          "name": "telegramBotToken",
          "title": "Telegram Bot Token",
          "description": "Token for your Telegram Bot (get from @BotFather)",
          "type": "password",
          "required": false
        },
        {
          "name": "telegramChatId",
          "title": "Telegram Default Chat ID",
          "description": "Default Chat ID or Channel ID to send messages to",
          "type": "textfield",
          "required": false
        }
      ]
    },
    {
      "name": "archive-manager",
